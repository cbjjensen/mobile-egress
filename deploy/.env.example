# Public TLS tunnel port exposed by Docker Compose.
RELAY_PORT=8443

# Container listen address. Keep the container port aligned with the Compose mapping.
RELAY_LISTEN=0.0.0.0:8443

# DNS name or IP placed in the relay certificate during the one-time init profile.
RELAY_PUBLIC_NAME=relay.example.com

# Exact public HTTPS origin included with the relay CA in owner pairing bundles.
RELAY_PUBLIC_URL=https://relay.example.com:8443
