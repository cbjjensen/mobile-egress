    {
      "id": "agent.stream-capacity",
      "title": "Phone-wide bounded queue and in-flight debt with per-stream backpressure",
      "platforms": {
        "android": {
          "status": "native-equivalent",
          "nativeEquivalenceNotes": "Pauses native target reads when their stream owns 32 outbound frames, including transport-owned frames, and resumes after capacity refunds. The selector disables only read interest and keeps command batches responsive. Idle targets hold no aggregate read reservation; aggregate frame/byte overload retains the existing stream-local close.",
          "sourceEvidence": [
            "android/app/src/main/java/com/mobileegress/agent/session/AgentSession.kt",
            "android/app/src/main/java/com/mobileegress/agent/session/AgentTargetBridge.kt",
            "android/app/src/main/java/com/mobileegress/agent/session/StreamAdmission.kt",
            "android/app/src/main/java/com/mobileegress/agent/session/OutboundMailbox.kt",
            "android/app/src/main/java/com/mobileegress/agent/session/TargetIoReactor.kt",
            "android/app/src/main/java/com/mobileegress/agent/session/OutboundSender.kt",
            "android/app/src/main/java/com/mobileegress/agent/session/PhoneBudgets.kt"
          ],
          "testEvidence": [
            "android/app/src/test/java/com/mobileegress/agent/session/AgentTargetBridgeTest.kt",
            "android/app/src/test/java/com/mobileegress/agent/session/StreamAdmissionTest.kt",
            "android/app/src/test/java/com/mobileegress/agent/session/OutboundMailboxTest.kt",
            "android/app/src/test/java/com/mobileegress/agent/session/TargetIoReactorTest.kt",
            "android/app/src/test/java/com/mobileegress/agent/session/OutboundSenderTest.kt",
            "android/app/src/test/java/com/mobileegress/agent/session/TargetIoReactorIntegrationTest.kt",
            "android/app/src/test/java/com/mobileegress/agent/session/PhoneBudgetTest.kt"
          ]
        },
        "ios": {
          "status": "native-equivalent",
          "nativeEquivalenceNotes": "Network.framework callbacks retain phone-wide reservations until native completion; Android uses selector reactors. Both share directional 8192-frame/64-MiB debt across Clients, retain 32 frames per stream and charge queued plus in-flight data. Physical sustained fairness and thermal acceptance are separate release gates.",
          "sourceEvidence": [
            "ios/Sources/MobileEgressCore/Runtime/AgentRuntimeModels.swift",
            "ios/Sources/MobileEgressCore/Session/SessionPrimitives.swift",
            "ios/Sources/MobileEgressCore/Runtime/AgentSessionStateMachine.swift",
            "ios/Sources/MobileEgressCore/Runtime/AgentSessionRuntime.swift",
            "ios/Sources/MobileEgressCore/Runtime/NetworkTargetConnection.swift",
            "ios/Sources/MobileEgressCore/Direct/DirectPhoneBudget.swift",
            "ios/Sources/MobileEgressCore/Direct/DirectReadTurns.swift"
          ],
          "testEvidence": [
            "ios/Tests/MobileEgressCoreTests/RelayRuntimeConfigurationTests.swift",
            "ios/Tests/MobileEgressCoreTests/AgentSessionStateMachineTests.swift",
            "ios/Tests/MobileEgressCoreTests/SessionPrimitivesTests.swift",
            "ios/Tests/MobileEgressCoreTests/AgentSessionRuntimeTests.swift",
            "ios/Tests/MobileEgressCoreTests/NetworkTargetBackpressureTests.swift",
            "ios/Tests/MobileEgressCoreTests/DirectReadTurnTests.swift",
            "ios/Tests/MobileEgressCoreTests/ProviderMessagingTests.swift",
            "ios/Tests/MobileEgressCoreTests/DirectAgentTests.swift"
          ]
        }
      }
    },
