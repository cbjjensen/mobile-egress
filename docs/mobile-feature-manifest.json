          "nativeEquivalenceNotes": "Uses checked-in Apple asset-catalog AppIcon and header images generated from the selected ZFNF source, with the approved ZFNF Mobile Egress host, Agent extension, VPN, and safe-diagnostics names on Apple system surfaces.",
          "sourceEvidence": [
            "ios/Sources/MobileEgressCore/Presentation/AgentDashboardPresentation.swift",
            "ios/MobileEgressAgent/Info.plist",
            "ios/MobileEgressTunnelExtension/Info.plist",
            "ios/MobileEgressAgent/TunnelManager.swift",
            "ios/Assets/AppAssets.xcassets/ZFNFHeader.imageset/ZFNFHeader.png"
          ],
          "testEvidence": [
