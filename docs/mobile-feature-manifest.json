    {
      "id": "agent.cellular-relay-visibility",
      "title": "Separate cellular and relay health visibility",
      "platforms": {
        "android": {
          "status": "implemented",
          "sourceEvidence": [
            "android/app/src/main/java/com/mobileegress/agent/status/AgentStatus.kt",
            "android/app/src/main/java/com/mobileegress/agent/ui/AgentScreen.kt"
          ],
          "testEvidence": [
