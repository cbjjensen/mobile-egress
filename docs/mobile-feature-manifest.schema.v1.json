{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-egress.local/schemas/mobile-feature-manifest.schema.v1.json",
  "title": "Mobile Egress mobile feature manifest schema v1",
  "type": "object",
  "required": ["schemaVersion", "features"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "platforms"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "platforms": {
            "type": "object",
            "required": ["android", "ios"],
            "additionalProperties": false,
            "properties": {
              "android": {
                "$ref": "#/$defs/platformFeature"
              },
              "ios": {
                "$ref": "#/$defs/platformFeature"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "platformFeature": {
      "type": "object",
      "required": ["status", "sourceEvidence", "testEvidence"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["implemented", "native-equivalent"]
        },
        "nativeEquivalenceNotes": {
          "type": "string"
        },
        "sourceEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "testEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
