+func waitForClosingStream(t *testing.T, relay *Service, id string) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for {
+		relay.mu.RLock()
+		tracked := relay.streams[id]
+		closing := tracked != nil && tracked.closing
+		relay.mu.RUnlock()
+		if closing {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("stream did not start draining")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
