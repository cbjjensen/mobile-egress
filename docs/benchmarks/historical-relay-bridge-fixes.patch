+func TestOrderlyCloseDrainsQueuedDataBeforeClose(t *testing.T) {
+	for _, fromAgent := range []bool{false, true} {
+		for _, binary := range []bool{false, true} {
+			t.Run(fmt.Sprintf("from-agent=%t/binary=%t", fromAgent, binary), func(t *testing.T) {
+				relay := newWriterTestService()
+				client := newDormantSession(relay, "client", enrollment.RoleClient)
+				agent := newDormantSession(relay, "agent", enrollment.RoleAgent)
+				registerTestSessions(relay, client, agent)
+				defer closeTestSessions(client, agent)
+				tracked := &stream{id: "tail", client: client, agent: agent, state: streamOpen}
+				relay.streams[tracked.id] = tracked
+				relay.activeStreams = 1
+				sender, recipient, code := client, agent, "client_closed"
+				if fromAgent {
+					sender, recipient, code = agent, client, "target_closed"
+				}
+				payload := bytes.Repeat([]byte{'x'}, 16<<10)
+				for i := 0; i < 2; i++ {
+					raw, err := (protocol.Envelope{Version: 1, Type: protocol.TypeData, StreamID: tracked.id, Data: payload}).MarshalForPeer(binary)
+					if err != nil {
+						t.Fatal(err)
+					}
+					frame, err := tunnelwire.ParseEnvelope(raw)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if err := relay.routeEnvelope(sender, frame); err != nil {
+						t.Fatal(err)
+					}
+				}
+				if err := relay.routeEnvelope(sender, streamCloseEnvelope(tracked.id, code)); err != nil {
+					t.Fatal(err)
+				}
+				// Heartbeats must still pass a blocked close barrier for another stream.
+				if err := recipient.send(protocol.Envelope{Version: 1, Type: protocol.TypePong}); err != nil {
+					t.Fatal(err)
+				}
+				for index, want := range []protocol.MessageType{protocol.TypePong, protocol.TypeData, protocol.TypeData, protocol.TypeClose} {
+					item, ok := recipient.outbound.poll()
+					if !ok || item.envelope.Type != want {
+						t.Fatalf("forwarded frame %d = %#v/%t, want %s", index, item, ok, want)
+					}
+					if want == protocol.TypeData && item.envelope.PayloadBytes() != len(payload) {
+						t.Fatal("truncated payload")
+					}
+					item.complete()
+				}
+				assertOutboundBudgetUsage(t, recipient.outbound.dataBudget, 0, 0)
+				if relay.activeStreams != 0 || len(relay.streams) != 0 {
+					t.Fatal("drained stream still occupies a slot")
+				}
+				if err := relay.routeEnvelope(sender, streamCloseEnvelope(tracked.id, code)); err != nil {
+					t.Fatalf("duplicate close: %v", err)
+				}
+				if _, ok := recipient.outbound.poll(); ok {
+					t.Fatal("duplicate close was forwarded")
+				}
+			})
+		}
+	}
+}
