+func TestClosingStreamCancellationDiscardsTail(t *testing.T) {
+	for _, initialAgent := range []bool{false, true} {
+		for _, opposing := range []bool{false, true} {
+			t.Run(fmt.Sprintf("agent-eof=%t/opposing=%t", initialAgent, opposing), func(t *testing.T) {
+				relay := newWriterTestService()
+				client := newDormantSession(relay, "client", enrollment.RoleClient)
+				agent := newDormantSession(relay, "agent", enrollment.RoleAgent)
+				registerTestSessions(relay, client, agent)
+				defer closeTestSessions(client, agent)
+				tracked := &stream{id: "tail", client: client, agent: agent, state: streamOpen}
+				relay.streams[tracked.id] = tracked
+				relay.activeStreams = 1
+				sender, recipient, orderly := client, agent, "client_closed"
+				if initialAgent {
+					sender, recipient, orderly = agent, client, "target_closed"
+				}
+				if err := relay.routeEnvelope(sender, dataEnvelope(tracked.id, "eA")); err != nil {
+					t.Fatal(err)
+				}
+				if err := relay.routeEnvelope(sender, streamCloseEnvelope(tracked.id, orderly)); err != nil {
+					t.Fatal(err)
+				}
+				// Duplicate EOF is idempotent while the original terminal barrier waits.
+				if err := relay.routeEnvelope(sender, streamCloseEnvelope(tracked.id, orderly)); err != nil {
+					t.Fatal(err)
+				}
+				if !recipient.outbound.hasStreamData(tracked.id) {
+					t.Fatal("duplicate orderly close discarded tail")
+				}
+				abortSender, abortRecipient, abortCode := sender, recipient, "target_failure"
+				if opposing {
+					abortSender, abortRecipient = recipient, sender
+					abortCode = "client_closed"
+					if abortSender == agent {
+						abortCode = "target_closed"
+					}
+				}
+				if err := relay.routeEnvelope(abortSender, streamCloseEnvelope(tracked.id, abortCode)); err != nil {
+					t.Fatal(err)
+				}
+				if len(relay.streams) != 0 || relay.activeStreams != 0 {
+					t.Fatal("cancellation retained draining stream")
+				}
+				assertOutboundBudgetUsage(t, recipient.outbound.dataBudget, 0, 0)
+				item, ok := abortRecipient.outbound.poll()
+				if !ok || item.envelope.Type != protocol.TypeClose || decodedErrorCode(t, item.envelope) != abortCode {
+					t.Fatal("cancellation did not replace queued orderly close")
+				}
+				item.complete()
+				for _, peer := range []*session{client, agent} {
+					if _, ok := peer.outbound.poll(); ok {
+						t.Fatal("canceled tail or terminal barrier survived")
+					}
+				}
+			})
+		}
+	}
+}
