+func TestShutdownDuringAdmissionDatabaseWaitPreventsRegistration(t *testing.T) {
+	fixture := newRelayFixture(t)
+	defer fixture.Close()
+	_, devices := enrollDevices(t, fixture, "agent")
+	relay := fixture.service
+	writer := newBlockingUpgradeResponseWriter()
+	defer writer.release()
+	request := authenticatedSessionRequest(t, devices[0])
+	done := make(chan struct{})
+	go func() { relay.handleSession(writer, request); close(done) }()
+	waitForSignal(t, writer.connection.writeStarted, "upgrade start")
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	reserved, err := relay.store.db.Conn(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reserved.Close()
+	before := relay.store.db.Stats().WaitCount
+	writer.release()
+	waitForDatabaseWait(t, relay, before)
+	closed := make(chan error, 1)
+	go func() { closed <- relay.Close() }()
+	deadline := time.Now().Add(time.Second)
+	for {
+		relay.mu.RLock()
+		stopped := relay.closed
+		relay.mu.RUnlock()
+		if stopped {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("shutdown waited for admission SQLite before stopping traffic")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	_ = reserved.Close()
+	waitForSignal(t, done, "stopped admission completion")
+	if err := <-closed; err != nil {
+		t.Fatal(err)
+	}
+	relay.mu.RLock()
+	registered := len(relay.sessions) != 0 || len(relay.pendingSessions) != 0 || relay.agentPending != nil
+	relay.mu.RUnlock()
+	if registered {
+		t.Fatal("shutdown admission occupied a session slot")
+	}
+}
