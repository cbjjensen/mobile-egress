+func TestOrderlyCloseExpiryDiscardsTailAndLateCompletionCannotRemoveReplacement(t *testing.T) {
+	for _, terminalInFlight := range []bool{false, true} {
+		t.Run(fmt.Sprintf("terminal-in-flight=%t", terminalInFlight), func(t *testing.T) {
+			relay := newWriterTestService()
+			relay.idleTimeout = time.Minute
+			client := newDormantSession(relay, "client", enrollment.RoleClient)
+			agent := newDormantSession(relay, "agent", enrollment.RoleAgent)
+			registerTestSessions(relay, client, agent)
+			defer closeTestSessions(client, agent)
+			tracked := &stream{id: "tail", client: client, agent: agent, state: streamOpen, lastActivity: time.Now()}
+			agent.lastInbound = tracked.lastActivity
+			relay.streams[tracked.id] = tracked
+			relay.activeStreams = 1
+			if err := relay.routeEnvelope(agent, dataEnvelope(tracked.id, "eA")); err != nil {
+				t.Fatal(err)
+			}
+			if err := relay.routeEnvelope(agent, streamCloseEnvelope(tracked.id, "target_closed")); err != nil {
+				t.Fatal(err)
+			}
+			var terminal *outboundMailboxItem
+			if terminalInFlight {
+				item, ok := client.outbound.poll()
+				if !ok || item.envelope.Type != protocol.TypeData {
+					t.Fatal("missing tail")
+				}
+				item.complete()
+				terminal, ok = client.outbound.poll()
+				if !ok || terminal.envelope.Type != protocol.TypeClose {
+					t.Fatal("missing in-flight close")
+				}
+			}
+			relay.expireStreams(tracked.lastActivity.Add(time.Minute))
+			if len(relay.streams) != 0 || relay.activeStreams != 0 {
+				t.Fatal("expiry leaked draining stream")
+			}
+			assertOutboundBudgetUsage(t, client.outbound.dataBudget, 0, 0)
+			for _, peer := range []*session{client, agent} {
+				item, ok := peer.outbound.poll()
+				if !ok || item.envelope.Type != protocol.TypeClose || decodedErrorCode(t, item.envelope) != "idle_timeout" {
+					t.Fatal("expiry did not supersede orderly close")
+				}
+				item.complete()
+				if _, ok := peer.outbound.poll(); ok {
+					t.Fatal("expired tail survived cleanup")
+				}
+			}
+			// Model a writer finishing after expiry, tombstone expiry and ID reuse.
+			if terminal != nil {
+				replacement := &stream{id: tracked.id, client: client, agent: agent, state: streamOpen}
+				relay.streams[replacement.id] = replacement
+				relay.activeStreams = 1
+				terminal.complete()
+				terminal.complete()
+				if relay.streams[replacement.id] != replacement || relay.activeStreams != 1 {
+					t.Fatal("old close completion removed replacement stream")
+				}
+			}
+		})
+	}
+}
