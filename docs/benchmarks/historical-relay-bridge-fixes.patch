+func TestTargetEOFDeliversTailThroughSlowRelayWriter(t *testing.T) {
+	for _, binaryClient := range []bool{false, true} {
+		for _, binaryAgent := range []bool{false, true} {
+			t.Run(fmt.Sprintf("client-binary=%t/agent-binary=%t", binaryClient, binaryAgent), func(t *testing.T) {
+				fixture := newRelayFixture(t)
+				defer fixture.Close()
+				_, devices := enrollDevices(t, fixture, "client", "agent")
+				dial := func(device enrolledDevice, binary bool) *websocket.Conn {
+					if binary {
+						return dialTransport2(t, fixture, device.client)
+					}
+					return mustDialSession(t, fixture, device.client)
+				}
+				client, agent := dial(devices[0], binaryClient), dial(devices[1], binaryAgent)
+				defer client.Close()
+				defer agent.Close()
+				writeEnvelope(t, client, openEnvelope("tail", "1.1.1.1", 443))
+				_ = readEnvelope(t, agent)
+				writeEnvelope(t, agent, protocol.Envelope{Version: 1, Type: protocol.TypeOpened, StreamID: "tail"})
+				_ = readEnvelope(t, client)
+				fixture.service.mu.RLock()
+				relayClient := fixture.service.sessions[devices[0].serial]
+				fixture.service.mu.RUnlock()
+				relayClient.writeMu.Lock()
+				locked := true
+				defer func() {
+					if locked {
+						relayClient.writeMu.Unlock()
+					}
+				}()
+				payload := bytes.Repeat([]byte("tail-data"), 2<<10)
+				for i := 0; i < 2; i++ {
+					raw, err := (protocol.Envelope{Version: 1, Type: protocol.TypeData, StreamID: "tail", Data: payload}).MarshalForPeer(binaryAgent)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if err := agent.WriteMessage(websocket.BinaryMessage, raw); err != nil {
+						t.Fatal(err)
+					}
+				}
+				writeEnvelope(t, agent, streamCloseEnvelope("tail", "target_closed"))
+				waitForClosingStream(t, fixture.service, "tail")
+				relayClient.writeMu.Unlock()
+				locked = false
+				var received []byte
+				for i := 0; i < 3; i++ {
+					frame := readEnvelope(t, client)
+					if i < 2 {
+						if frame.Type != protocol.TypeData {
+							t.Fatalf("tail frame %d = %s", i, frame.Type)
+						}
+						data, err := frame.DecodePayload()
+						if err != nil {
+							t.Fatal(err)
+						}
+						received = append(received, data...)
+					} else if frame.Type != protocol.TypeClose || decodedErrorCode(t, frame) != "target_closed" {
+						t.Fatal("missing orderly EOF")
+					}
+				}
+				if !bytes.Equal(received, bytes.Repeat(payload, 2)) {
+					t.Fatalf("received %d of %d tail bytes", len(received), 2*len(payload))
+				}
+				waitForStreamRemoval(t, fixture.service, "tail")
+			})
+		}
+	}
+}
