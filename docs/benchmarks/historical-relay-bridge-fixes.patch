+// Keep the stream registered (and its capacity reserved) until its terminal
+// frame finishes. Revocation, session loss, expiry and shutdown can therefore
+// still find it and immediately discard its queued tail.
+func (service *Service) queueOrderlyCloseLocked(tracked *stream, sender, recipient *session, envelope protocol.Envelope) outboundAdmission {
+	tracked.closing = true
+	tracked.closingSender = sender
+	if sender.outbound != nil {
+		sender.outbound.discardStreamData(tracked.id)
+	}
+	if recipient == nil || recipient.outbound == nil {
+		service.removeStreamLocked(tracked)
+		return outboundClosed
+	}
+	if !recipient.outbound.hasStreamData(tracked.id) {
+		service.removeStreamLocked(tracked)
+		return recipient.outbound.enqueue(envelope)
+	}
+	admission := recipient.outbound.enqueueAfterData(envelope, func() {
+		service.mu.Lock()
+		service.removeStreamLocked(tracked)
+		service.mu.Unlock()
+	})
+	if admission != outboundAdmitted {
+		service.removeStreamLocked(tracked)
+	}
+	return admission
+}
