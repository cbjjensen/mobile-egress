+func TestOrderlyCloseBarrierUsesBoundedControlLane(t *testing.T) {
+	relay := newWriterTestService()
+	client := newDormantSession(relay, "client", enrollment.RoleClient)
+	agent := newDormantSession(relay, "agent", enrollment.RoleAgent)
+	client.outbound.controlCapacity = 1
+	registerTestSessions(relay, client, agent)
+	defer closeTestSessions(client, agent)
+	for _, id := range []string{"first", "overflow"} {
+		tracked := &stream{id: id, client: client, agent: agent, state: streamOpen}
+		relay.streams[id] = tracked
+		relay.activeStreams++
+		if err := relay.routeEnvelope(agent, dataEnvelope(id, "eA")); err != nil {
+			t.Fatal(err)
+		}
+		if err := relay.routeEnvelope(agent, streamCloseEnvelope(id, "target_closed")); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if client.registered {
+		t.Fatal("terminal control overflow did not close affected session")
+	}
+	if !agent.registered {
+		t.Fatal("terminal control overflow closed unrelated session")
+	}
+	if len(relay.streams) != 0 || relay.activeStreams != 0 {
+		t.Fatal("overflow leaked draining streams")
+	}
+	assertOutboundBudgetUsage(t, client.outbound.dataBudget, 0, 0)
+}
