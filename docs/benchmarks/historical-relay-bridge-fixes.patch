+func TestClosingStreamLateDataDoesNotChurnTombstones(t *testing.T) {
+	relay := newWriterTestService()
+	client := newDormantSession(relay, "client", enrollment.RoleClient)
+	agent := newDormantSession(relay, "agent", enrollment.RoleAgent)
+	registerTestSessions(relay, client, agent)
+	defer closeTestSessions(client, agent)
+	for i := 0; i < maxClosedStreamTombstones; i++ {
+		id := fmt.Sprintf("closed-%d", i)
+		relay.closedStreams[id] = closedStreamTombstone{expiresAt: time.Now().Add(time.Minute)}
+	}
+	tracked := &stream{id: "tail", client: client, agent: agent, state: streamOpen}
+	relay.streams[tracked.id] = tracked
+	relay.activeStreams = 1
+	if err := relay.routeEnvelope(agent, dataEnvelope(tracked.id, "eA")); err != nil {
+		t.Fatal(err)
+	}
+	if err := relay.routeEnvelope(agent, streamCloseEnvelope(tracked.id, "target_closed")); err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < maxClosedStreamTombstones; i++ {
+		if err := relay.routeEnvelope(client, dataEnvelope(tracked.id, "eA")); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if len(relay.closedStreams) != maxClosedStreamTombstones {
+		t.Fatal("late frames changed tombstone capacity")
+	}
+	for i := 0; i < maxClosedStreamTombstones; i++ {
+		if _, exists := relay.closedStreams[fmt.Sprintf("closed-%d", i)]; !exists {
+			t.Fatal("late data churned existing tombstones")
+		}
+	}
+}
