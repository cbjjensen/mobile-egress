+func TestWindowsClientReadsCompleteTailBeforeEOF(t *testing.T) {
+	for _, binaryAgent := range []bool{false, true} {
+		t.Run(fmt.Sprintf("binary-agent=%t", binaryAgent), func(t *testing.T) {
+			fixture := newRelayFixture(t)
+			defer fixture.Close()
+			_, devices := enrollDevices(t, fixture, "client", "agent")
+			var agent *websocket.Conn
+			if binaryAgent {
+				agent = dialTransport2(t, fixture, devices[1].client)
+			} else {
+				agent = mustDialSession(t, fixture, devices[1].client)
+			}
+			defer agent.Close()
+			client := dialWindowsSession(t, fixture, devices[0])
+			defer client.Close()
+			opened := openWindowsStream(t, client, agent, "1.1.1.1", 443)
+			defer opened.stream.Close()
+			fixture.service.mu.RLock()
+			relayClient := fixture.service.sessions[devices[0].serial]
+			fixture.service.mu.RUnlock()
+			relayClient.writeMu.Lock()
+			locked := true
+			defer func() {
+				if locked {
+					relayClient.writeMu.Unlock()
+				}
+			}()
+			payload := bytes.Repeat([]byte("tail"), 4<<10)
+			for i := 0; i < 2; i++ {
+				raw, err := (protocol.Envelope{Version: 1, Type: protocol.TypeData, StreamID: opened.id, Data: payload}).MarshalForPeer(binaryAgent)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err := agent.WriteMessage(websocket.BinaryMessage, raw); err != nil {
+					t.Fatal(err)
+				}
+			}
+			writeEnvelope(t, agent, streamCloseEnvelope(opened.id, "target_closed"))
+			waitForClosingStream(t, fixture.service, opened.id)
+			relayClient.writeMu.Unlock()
+			locked = false
+			read := make(chan []byte, 1)
+			errors := make(chan error, 1)
+			go func() {
+				data, err := io.ReadAll(opened.stream)
+				if err != nil {
+					errors <- err
+				} else {
+					read <- data
+				}
+			}()
+			select {
+			case received := <-read:
+				if !bytes.Equal(received, bytes.Repeat(payload, 2)) {
+					t.Fatalf("Windows received %d of %d bytes before EOF", len(received), 2*len(payload))
+				}
+			case err := <-errors:
+				t.Fatal(err)
+			case <-time.After(2 * time.Second):
+				t.Fatal("Windows read did not reach EOF")
+			}
+			waitForStreamRemoval(t, fixture.service, opened.id)
+		})
+	}
+}
