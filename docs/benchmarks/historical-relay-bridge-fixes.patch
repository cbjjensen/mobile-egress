+// Caller has checked session and stream ownership and holds mu; this releases
+// it like the normal routing exit. Validate late data against the retained
+// stream in O(1), without creating/evicting tombstones for every late frame.
+func (service *Service) absorbClosingStreamFrameLocked(tracked *stream, sender *session, envelope protocol.Envelope) error {
+	if err := envelope.Validate(); err == nil {
+		if envelope.Type == protocol.TypeData && tracked.state == streamOpen {
+			service.mu.Unlock()
+			return nil
+		}
+		if envelope.Type == protocol.TypeClose && validEnvelopeErrorCode(envelope) {
+			orderlyCode := "client_closed"
+			if sender.role == enrollment.RoleAgent {
+				orderlyCode = "target_closed"
+			}
+			if sender == tracked.closingSender && envelope.Payload == encodeRelayError(orderlyCode) {
+				service.mu.Unlock()
+				return nil // Duplicate EOF must not discard its own pending tail.
+			}
+			// The recipient canceled, or the sender replaced EOF with an error.
+			// Either supersedes the pending drain and refunds queued bytes now.
+			recipient := tracked.agent
+			if sender == tracked.agent {
+				recipient = tracked.client
+			}
+			service.removeStreamLocked(tracked)
+			service.mu.Unlock()
+			if recipient != nil {
+				_ = recipient.send(envelope)
+			}
+			return nil
+		}
+	}
+	service.mu.Unlock()
+	return errors.New("invalid frame for closing stream")
+}
