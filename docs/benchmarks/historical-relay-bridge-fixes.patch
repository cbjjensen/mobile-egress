+func TestOrderlyCloseWaitsForInFlightDataAndAbortCancelsBarrier(t *testing.T) {
+	for _, abort := range []bool{false, true} {
+		t.Run(fmt.Sprintf("abort=%t", abort), func(t *testing.T) {
+			relay := newWriterTestService()
+			client := newDormantSession(relay, "client", enrollment.RoleClient)
+			agent := newDormantSession(relay, "agent", enrollment.RoleAgent)
+			registerTestSessions(relay, client, agent)
+			defer closeTestSessions(client, agent)
+			tracked := &stream{id: "tail", client: client, agent: agent, state: streamOpen}
+			relay.streams[tracked.id] = tracked
+			relay.activeStreams = 1
+			if err := relay.routeEnvelope(agent, dataEnvelope(tracked.id, "eA")); err != nil {
+				t.Fatal(err)
+			}
+			inFlight, ok := client.outbound.poll()
+			if !ok {
+				t.Fatal("no data")
+			}
+			if err := relay.routeEnvelope(agent, streamCloseEnvelope(tracked.id, "target_closed")); err != nil {
+				t.Fatal(err)
+			}
+			if _, ok := client.outbound.poll(); ok {
+				t.Fatal("close overtook in-flight data")
+			}
+			if relay.streams[tracked.id] == nil {
+				t.Fatal("draining stream detached before completion")
+			}
+			if abort {
+				agent.close("revoked")
+			}
+			inFlight.complete()
+			item, ok := client.outbound.poll()
+			if !ok || item.envelope.Type != protocol.TypeClose {
+				t.Fatal("missing terminal close")
+			}
+			wantCode := "target_closed"
+			if abort {
+				wantCode = "revoked"
+			}
+			if code := decodedErrorCode(t, item.envelope); code != wantCode {
+				t.Fatalf("close = %s, want %s", code, wantCode)
+			}
+			item.complete()
+			if _, ok := client.outbound.poll(); ok {
+				t.Fatal("stale orderly close survived abort")
+			}
+			assertOutboundBudgetUsage(t, client.outbound.dataBudget, 0, 0)
+			if len(relay.streams) != 0 || relay.activeStreams != 0 {
+				t.Fatal("stream reservation leaked")
+			}
+		})
+	}
+}
